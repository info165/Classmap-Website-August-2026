# RESEND_API_KEY: Required for sending demo request emails via Resend.
RESEND_API_KEY=

# RESEND_FROM_EMAIL: Sender for demo request emails. Must be an address on a
# domain verified in Resend. If unset, falls back to Resend's test sender
# (onboarding@resend.dev), which only delivers to the Resend account owner.
RESEND_FROM_EMAIL=ClassMap Demo <demo@classmap.in>

# DEMO_NOTIFY_EMAIL: Inbox that receives demo requests. Defaults to info@classmap.in.
DEMO_NOTIFY_EMAIL=info@classmap.in

# PORT: Port the server listens on. Defaults to 4000.
PORT=4000

# NODE_ENV: Must be "production" on the live server, otherwise the app boots
# the Vite dev middleware instead of serving the built dist/ folder.
# Leave unset (or "development") for local development.
NODE_ENV=

# Classmapwebsite Dedicated Storage & Billing Configuration
VITE_FIREBASE_PROJECT_ID=classmap-website-data
VITE_WEBSITE_STORAGE_BUCKET=classmap-website-data.firebasestorage.app
VITE_WEBSITE_BILLING_ACCOUNT_ID=BILL-CM-WEB-492070077067
VITE_WEBSITE_GSTIN=19AADCF7685E1ZA
VITE_WEBSITE_BILLING_EMAIL=info@funscholar.com
